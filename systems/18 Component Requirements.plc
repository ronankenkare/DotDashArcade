        "kind": "document-requirement",
        "ownerId": "requirement-group-b85d4bb8-055d-401c-b23e-b1dddbba271e",
        "name": "CMP-015 Mode change",
        "documentation": "changeMode to a different mode shall stop any run, apply that mode's start values and show instructions without a game-over result or saved best. changeMode to the current mode shall do nothing.",
        "properties": {
          "key": "CMP-015",
          "title": "Mode change",
          "statement": "changeMode to a different mode shall stop any run, apply that mode's start values and show instructions without a game-over result or saved best. changeMode to the current mode shall do nothing."
        },
        "createdAt": "2026-10-28T17:30:31.621Z",
        "modifiedAt": "2026-10-28T17:30:31.621Z"
      },
      {
        "id": "document-requirement-c36c7b35-83bf-4f91-98a0-33f7c134fadb",
        "kind": "document-requirement",
        "ownerId": "requirement-group-b85d4bb8-055d-401c-b23e-b1dddbba271e",
        "name": "CMP-016 Pause to instructions",
        "documentation": "pauseToHelp shall stop an active run, show instructions and clear gameOver; it shall do nothing when no run is active.",
        "properties": {
          "key": "CMP-016",
          "title": "Pause to instructions",
          "statement": "pauseToHelp shall stop an active run, show instructions and clear gameOver; it shall do nothing when no run is active."
