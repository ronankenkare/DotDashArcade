      {
        "id": "document-requirement-9cc4b821-cf83-4e2e-89ca-f74ad3d329bd",
        "kind": "document-requirement",
        "ownerId": "requirement-group-b85d4bb8-055d-401c-b23e-b1dddbba271e",
        "name": "CMP-017 Display link ownership",
        "documentation": "startLoop shall create and schedule one CADisplayLink on the main run loop in common modes only when none exists; stopLoop and deinit shall invalidate it.",
        "properties": {
          "key": "CMP-017",
          "title": "Display link ownership",
          "statement": "startLoop shall create and schedule one CADisplayLink on the main run loop in common modes only when none exists; stopLoop and deinit shall invalidate it."
        },
        "createdAt": "2026-10-28T17:30:31.621Z",
        "modifiedAt": "2026-10-28T17:30:31.621Z"
      },
      {
        "id": "document-requirement-000fbacd-98ba-4b73-9d1f-a2bfd860ae46",
        "kind": "document-requirement",
        "ownerId": "requirement-group-b85d4bb8-055d-401c-b23e-b1dddbba271e",
        "name": "CMP-018 Best loading and migration",
        "documentation": "GameState shall load both mode bests from their keys at initialization and copy a positive dotdash_best_v1 into dotdash_best_classic_v1 only when the stored Classic best is zero.",
        "properties": {
          "key": "CMP-018",
          "title": "Best loading and migration",
          "statement": "GameState shall load both mode bests from their keys at initialization and copy a positive dotdash_best_v1 into dotdash_best_classic_v1 only when the stored Classic best is zero."
        },
        "createdAt": "2026-10-28T17:30:31.621Z",
        "modifiedAt": "2026-10-28T17:30:31.621Z"
      },
      {
        "id": "document-requirement-b657c37d-7a9e-43e4-acad-ff555aaffdb4",
        "kind": "document-requirement",
        "ownerId": "requirement-group-56d244a8-6e65-486c-8c88-b34b01b52a58",
        "name": "CMP-019 Scene lifecycle",
        "documentation": "GameView shall apply the initial mode, show instructions and start the display link on appear; stop the link on disappear; pause to instructions and stop the link on inactive or background; and restart only the link on active.",
        "properties": {
          "key": "CMP-019",
          "title": "Scene lifecycle",
          "statement": "GameView shall apply the initial mode, show instructions and start the display link on appear; stop the link on disappear; pause to instructions and stop the link on inactive or background; and restart only the link on active."
        },
        "createdAt": "2026-10-28T17:30:31.621Z",
        "modifiedAt": "2026-10-28T17:30:31.621Z"
      },
