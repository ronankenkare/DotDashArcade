      {
        "id": "document-requirement-efa3c199-3dd3-4f0d-811d-85a5a1937d73",
        "kind": "document-requirement",
        "ownerId": "requirement-group-95033059-e5e6-4c55-8d1e-48ab0a65c687",
        "name": "CMP-011 Theme thresholds",
        "documentation": "pickThemeIndex shall return 0 below 12, 1 from 12, 2 from 25 and 3 from 40.",
        "properties": {
          "key": "CMP-011",
          "title": "Theme thresholds",
          "statement": "pickThemeIndex shall return 0 below 12, 1 from 12, 2 from 25 and 3 from 40."
        },
        "createdAt": "2026-10-28T17:30:31.621Z",
        "modifiedAt": "2026-10-28T17:30:31.621Z"
      },
      {
        "id": "document-requirement-5d039f61-dbda-4bef-98a2-a72e7585a82d",
        "kind": "document-requirement",
        "ownerId": "requirement-group-95033059-e5e6-4c55-8d1e-48ab0a65c687",
        "name": "CMP-012 Target relocation",
        "documentation": "pickNewZoneCenter shall sample centers in 0.15...0.85, trying up to 16 times for a move of at least max(0.08, min(0.22, zoneWidth × 0.9 + 0.06)) and otherwise accepting the last candidate.",
        "properties": {
          "key": "CMP-012",
          "title": "Target relocation",
          "statement": "pickNewZoneCenter shall sample centers in 0.15...0.85, trying up to 16 times for a move of at least max(0.08, min(0.22, zoneWidth × 0.9 + 0.06)) and otherwise accepting the last candidate."
        },
        "createdAt": "2026-10-28T17:30:31.621Z",
        "modifiedAt": "2026-10-28T17:30:31.621Z"
      },
      {
        "id": "document-requirement-5379f9fa-4256-42a4-9696-f2a5b1edef9e",
        "kind": "document-requirement",
        "ownerId": "requirement-group-b85d4bb8-055d-401c-b23e-b1dddbba271e",
        "name": "CMP-013 Run reset",
        "documentation": "reset shall start a run in the current mode with its start speed, width and perfect fraction, a random marker position and direction, a target centered at 0.5, score 0, no particles, no flash and theme 0.",
        "properties": {
          "key": "CMP-013",
          "title": "Run reset",
          "statement": "reset shall start a run in the current mode with its start speed, width and perfect fraction, a random marker position and direction, a target centered at 0.5, score 0, no particles, no flash and theme 0."
        },
        "createdAt": "2026-10-28T17:30:31.621Z",
        "modifiedAt": "2026-10-28T17:30:31.621Z"
      },
      {
        "id": "document-requirement-81403b55-3819-4c47-9293-d75f9066936e",
        "kind": "document-requirement",
        "ownerId": "requirement-group-b85d4bb8-055d-401c-b23e-b1dddbba271e",
        "name": "CMP-014 Stopped tap",
        "documentation": "handleTap shall call reset whenever no run is active.",
        "properties": {
          "key": "CMP-014",
          "title": "Stopped tap",
          "statement": "handleTap shall call reset whenever no run is active."
        },
        "createdAt": "2026-10-28T17:30:31.621Z",
        "modifiedAt": "2026-10-28T17:30:31.621Z"
      },
      {
