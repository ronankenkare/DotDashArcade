      {
        "id": "diagram-ba03d34d-d826-4765-9ebe-1b89f1b722e4",
        "kind": "diagram",
        "ownerId": "project-46fd9abf-e819-45fa-ad0a-2c9c698d8d3b",
        "name": "17 iPhone Duo UI",
        "documentation": "Screenshot-based UI flow using four unmodified PNG captures of Dot Dash on the installed iPhone Duo simulator, iOS 27.1, LCD screenID 1. The original wireframes were replaced. Image layers and transparent interaction hotspots form the native prototype. Capture flow passed; it checks Home, instructions, running, and Game Over, not the full app regression suite.",
        "properties": {
          "diagramKind": "ui"
        },
        "createdAt": "2026-10-21T22:01:17.934Z",
        "modifiedAt": "2026-10-21T22:14:32.342Z"
      },
